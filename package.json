{
  "name": "showora",
  "private": true,
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=22.14 <23",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "dev": "pnpm --filter @showora/shared-validation build && pnpm --parallel --filter @showora/api --filter @showora/admin dev",
    "dev:storefront": "pnpm --filter @showora/storefront dev",
    "build": "pnpm --filter @showora/api db:generate && pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm --filter @showora/shared-validation test && pnpm --filter @showora/api test",
    "test:integration": "pnpm --filter @showora/api test:integration",
    "test:db": "pnpm --filter @showora/api test:db",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter @showora/api db:generate",
    "db:migrate": "pnpm --filter @showora/api db:migrate",
    "db:configure": "pnpm --filter @showora/api db:configure",
    "local:env": "node infrastructure/scripts/local-env.mjs",
    "infra:up": "docker compose --env-file .env -f infrastructure/docker/compose.local.yml up -d --wait",
    "infra:down": "docker compose --env-file .env -f infrastructure/docker/compose.local.yml down"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.19.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "argon2",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  }
}
